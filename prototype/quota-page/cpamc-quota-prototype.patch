+
+.stripItem {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 14px;
+  border: 1px solid var(--border-color);
+  border-radius: 999px;
+  font-size: 13px;
+}
+
+.stripBar {
+  width: 90px;
+}
+
+.queue {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.queueRow {
+  display: grid;
+  grid-template-columns: 32px 20px minmax(220px, 1.2fr) minmax(200px, 1.4fr) 80px 2fr auto;
+  gap: 16px;
+  align-items: center;
+  padding: 14px 16px;
+  border: 1px solid var(--border-color);
+  border-radius: 12px;
+}
+
+.dimmed {
+  opacity: 0.55;
+}
+
+.rank {
+  font-size: 22px;
+  font-weight: 700;
+  text-align: center;
+  font-variant-numeric: tabular-nums;
+}
+
+.queueMain {
+  min-width: 0;
+}
+
+.queueUrgency {
+  text-align: center;
+  font-size: 12px;
+
+  strong {
+    font-size: 18px;
+  }
+}
+
+.chips {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.chip {
+  display: inline-flex;
+  align-items: center;
+  padding: 3px 9px;
+  border-radius: 999px;
+  background: var(--bg-tertiary);
+  font-size: 12px;
+}
+
+.chipBad {
+  color: var(--viz-failure);
+}
+
+/* ---------- switcher ---------- */
+
+.switcher {
+  position: fixed;
+  left: 50%;
+  bottom: 18px;
+  transform: translateX(-50%);
+  z-index: 1000;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 12px;
+  border-radius: 999px;
+  background: #ff3d7f;
+  color: #fff;
+  font-weight: 700;
+  font-size: 13px;
+  box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
+
+  button {
+    background: rgb(255 255 255 / 0.2);
+    border: none;
+    color: #fff;
+    border-radius: 50%;
+    width: 28px;
+    height: 28px;
+    cursor: pointer;
+    font-size: 15px;
+  }
+}
diff --git a/src/features/quota/prototype/QuotaPrototype.tsx b/src/features/quota/prototype/QuotaPrototype.tsx
new file mode 100644
index 0000000..df8c9ad
--- /dev/null
+++ b/src/features/quota/prototype/QuotaPrototype.tsx
@@ -0,0 +1,620 @@
+/**
+ * PROTOTYPE (throwaway): three Quota Management layouts on the real /quota
+ * route, picked with ?variant=A|B|C (stock when absent). Branch
+ * prototype/quota-ledger only. Answers bandoyer/CLIProxyAPI#30.
+ *
+ * A — Ledger: Theo's layout. Summary cards, then rows grouped by provider.
+ * B — Panels: one panel per provider; every window column carries its total.
+ * C — Queue: one list across providers, in expiring-first order.
+ *
+ * "Reset quota" is shown but disabled: it would spend a real manual reset.
+ */
+
+import { useMemo, useState, type ReactNode } from 'react';
+import { useTranslation } from 'react-i18next';
+import { IconRefreshCw } from '@/components/ui/icons';
+import { Select } from '@/components/ui/Select';
+import { useNow } from '@/hooks/useNow';
+import type { ResolvedTheme } from '@/types';
+import { formatInstantShort, formatRelativeInstant } from '@/utils/quota';
+import { getQuotaDisplayName } from '@/utils/quota/identity';
+import { getAuthFileIcon, getTypeLabel } from '@/features/authFiles/constants';
+import type { QuotaFileEntry } from '../logic';
+import type { QuotaCardState } from '../providers';
+import type { QuotaProviderType } from '../providers/types';
+import { buildRow, summarize, urgencyOf, type ProtoProviderSummary, type ProtoRow } from './model';
+import styles from './QuotaPrototype.module.scss';
+
+export const PROTOTYPE_VARIANTS = [
+  { key: 'stock', name: 'Stock' },
+  { key: 'A', name: 'Ledger (Theo)' },
+  { key: 'B', name: 'Provider panels' },
+  { key: 'C', name: 'Expiring-first queue' },
+] as const;
+
+export interface QuotaPrototypeProps {
+  variant: string;
+  entries: QuotaFileEntry[];
+  getQuota: (entry: QuotaFileEntry) => QuotaCardState | undefined;
+  resolvedTheme: ResolvedTheme;
+  canRefresh: boolean;
+  onRefresh: (entry: QuotaFileEntry) => void;
+  /** Stock card grid, for the "Ledger" drop-down's Cards option. */
+  renderCards: (entries: QuotaFileEntry[]) => ReactNode;
+}
+
+/* ---------- small shared pieces ---------- */
+
+const levelClass = (left: number | null) =>
+  left === null
+    ? styles.levelNone
+    : left >= 70
+      ? styles.levelHigh
+      : left >= 30
+        ? styles.levelMedium
+        : styles.levelLow;
+
+const pct = (value: number | null) => (value === null ? '--' : `${Math.round(value)}%`);
+
+function Bar({ left }: { left: number | null }) {
+  return (
+    <div className={styles.bar}>
+      <div
+        className={`${styles.barFill} ${levelClass(left)}`}
+        style={{ width: `${Math.min(100, Math.max(0, left ?? 0))}%` }}
+      />
+    </div>
+  );
+}
+
+function Segments({ values }: { values: (number | null)[] }) {
+  return (
+    <div className={styles.segments}>
+      {values.map((v, i) => (
+        <div key={i} className={styles.segment}>
+          <div
+            className={`${styles.barFill} ${levelClass(v)}`}
+            style={{ width: `${Math.min(100, Math.max(0, v ?? 0))}%` }}
+          />
+        </div>
+      ))}
+    </div>
+  );
+}
+
+function When({
+  atMs,
+  now,
+  empty = 'No reset pending',
+}: {
+  atMs: number | null;
+  now: number;
+  empty?: string;
+}) {
+  const { i18n } = useTranslation();
+  if (atMs === null) return <span className={`${styles.when} ${styles.muted}`}>{empty}</span>;
+  return (
+    <span className={styles.when}>
+      <span className={styles.whenRel}>
+        {formatRelativeInstant(atMs, now, i18n.resolvedLanguage)}
+      </span>
+      <span className={styles.muted}> · {formatInstantShort(atMs)}</span>
+    </span>
+  );
+}
+
+function ProviderIcon({ type, theme }: { type: QuotaProviderType; theme: ResolvedTheme }) {
+  const src = getAuthFileIcon(type, theme);
+  return src ? <img src={src} alt="" className={styles.icon} /> : null;
+}
+
+function PlanLine({ row, now }: { row: ProtoRow; now: number }) {
+  const { i18n } = useTranslation();
+  if (!row.plan && row.renewsAtMs === null) return null;
+  return (
+    <div className={styles.plan}>
+      {row.plan && <strong>{row.plan}</strong>}
+      {row.renewsAtMs !== null && (
+        <span className={styles.muted}>
+          {' '}
+          · renews {formatInstantShort(row.renewsAtMs)} ·{' '}
+          {formatRelativeInstant(row.renewsAtMs, now, i18n.resolvedLanguage)}
+        </span>
+      )}
+    </div>
+  );
+}
+
+function RowState({
+  row,
+  onRefresh,
+  canRefresh,
+}: {
+  row: ProtoRow;
+  onRefresh: () => void;
+  canRefresh: boolean;
+}) {
+  const { t } = useTranslation();
+  if (row.status === 'loading') return <span className={styles.muted}>Loading…</span>;
+  if (row.status === 'error')
+    return <span className={styles.error}>{row.quota?.error || t('common.unknown_error')}</span>;
+  if (row.status === 'idle')
+    return (
+      <button
+        type="button"
+        className={styles.linkButton}
+        onClick={onRefresh}
+        disabled={!canRefresh}
+      >
+        Not loaded — click to load
+      </button>
+    );
+  return null;
+}
+
+function Actions({
+  row,
+  onRefresh,
+  canRefresh,
+}: {
+  row: ProtoRow;
+  onRefresh: () => void;
+  canRefresh: boolean;
+}) {
+  const { t } = useTranslation();
+  return (
+    <div className={styles.actions}>
+      {row.entry.type === 'codex' && row.status === 'success' && (
+        <button
+          type="button"
+          className={styles.action}
+          disabled
+          title="Disabled in the prototype: it spends a real manual reset"
+        >
+          <IconRefreshCw size={13} /> {t('codex_quota.reset_button')}
+        </button>
+      )}
+      <button
+        type="button"
+        className={styles.action}
+        onClick={onRefresh}
+        disabled={!canRefresh || row.status === 'loading'}
+      >
+        <IconRefreshCw
+          size={13}
+          className={row.status === 'loading' ? styles.spinning : undefined}
+        />{' '}
+        {t('auth_files.quota_refresh_single')}
+      </button>
+    </div>
+  );
+}
+
+function WindowCell({
+  label,
+  left,
+  resetAtMs,
+  now,
+}: {
+  label?: string;
+  left: number | null;
+  resetAtMs: number | null;
+  now: number;
+}) {
+  return (
+    <div className={styles.windowCell}>
+      <div className={styles.windowHead}>
+        {label !== undefined && <span className={styles.windowLabel}>{label}</span>}
+        <span className={styles.windowPct}>{pct(left)}</span>
+      </div>
+      <Bar left={left} />
+      <When atMs={resetAtMs} now={now} />
+    </div>
+  );
+}
+
+function ExtraCell({ row, now }: { row: ProtoRow; now: number }) {
+  if (row.manualResets) {
+    return (
+      <div className={styles.windowCell}>
+        <div className={styles.windowHead}>
+          <span className={styles.windowLabel}>Manual resets</span>
+        </div>
+        <div>
+          <strong>{row.manualResets.count}</strong> <span className={styles.muted}>available</span>
+        </div>
+        {row.manualResets.firstExpiryMs !== null && (
+          <div className={styles.small}>
+            <span className={styles.muted}>Reset 1 expires </span>
+            <When atMs={row.manualResets.firstExpiryMs} now={now} />
+          </div>
+        )}
+      </div>
+    );
+  }
+  if (row.credits) {
+    const dollars = (c: number | null) => (c === null ? '--' : `$${(c / 100).toFixed(2)}`);
+    return (
+      <div className={styles.windowCell}>
+        <div className={styles.windowHead}>
+          <span className={styles.windowLabel}>Monthly credits</span>
+        </div>
+        <div>
+          <strong>{dollars(row.credits.usedCents)}</strong>{' '}
+          <span className={styles.muted}>/ {dollars(row.credits.limitCents)}</span>
+        </div>
+      </div>
+    );
+  }
+  return null;
+}
+
+/* ---------- data ---------- */
+
+function useSummaries(entries: QuotaFileEntry[], getQuota: QuotaPrototypeProps['getQuota']) {
+  const { t } = useTranslation();
+  return useMemo(() => {
+    const byType = new Map<QuotaProviderType, ProtoRow[]>();
+    entries.forEach((entry) => {
+      const rows = byType.get(entry.type) ?? [];
+      rows.push(buildRow(entry, getQuota(entry), t));
+      byType.set(entry.type, rows);
+    });
+    return Array.from(byType.entries()).map(([type, rows]) => summarize(type, rows));
+  }, [entries, getQuota, t]);
+}
+
+/* ---------- Variant A: Theo's ledger ---------- */
+
+function SummaryCard({
+  summary,
+  theme,
+  now,
+}: {
+  summary: ProtoProviderSummary;
+  theme: ResolvedTheme;
+  now: number;
+}) {
+  const { t } = useTranslation();
+  const [open, setOpen] = useState(false);
+  const h = summary.headline;
+  const others = summary.totals
+    .filter((x) => x !== h)
+    .sort((a, b) => (b.periodHours ?? 0) - (a.periodHours ?? 0));
+  const n = summary.rows.length;
+  return (
+    <div className={styles.summaryCard}>
+      <div className={styles.summaryHead}>
+        <ProviderIcon type={summary.type} theme={theme} />
+        <strong>{getTypeLabel(t, summary.type)}</strong>
+        <span className={styles.muted}>
+          {n} credential{n === 1 ? '' : 's'}
+        </span>
+      </div>
+      {h ? (
+        <>
+          <div className={styles.muted}>{h.label}</div>
+          <div className={styles.bigNumber}>
+            {pct(h.sumLeft)} <span className={styles.muted}>of {h.outOf}%</span>
+          </div>
+          <Segments values={h.segments} />
+          <When atMs={h.soonestResetMs} now={now} />
+          {others.length > 0 && (
+            <div className={styles.summaryOthers}>
+              {!open && (
+                <span>
+                  <span className={styles.muted}>{others[0].label}</span>{' '}
+                  <strong>{pct(others[0].sumLeft)}</strong>
+                </span>
+              )}
+              <button type="button" className={styles.linkButton} onClick={() => setOpen(!open)}>
+                {open ? 'Hide' : 'Show'}
+              </button>
+              {open &&
+                others.map((o) => (
+                  <div key={o.id} className={styles.summaryOther}>
+                    <div className={styles.windowHead}>
+                      <span className={styles.muted}>{o.label}</span>
+                      <span>
+                        <strong>{pct(o.sumLeft)}</strong>{' '}
+                        <span className={styles.muted}>of {o.outOf}%</span>
+                      </span>
+                    </div>
+                    <Segments values={o.segments} />
+                    <When atMs={o.soonestResetMs} now={now} />
+                  </div>
+                ))}
+            </div>
+          )}
+        </>
+      ) : (
+        <div className={styles.muted}>No readings loaded</div>
+      )}
+    </div>
+  );
+}
+
+function VariantA(props: QuotaPrototypeProps) {
+  const { entries, getQuota, resolvedTheme, canRefresh, onRefresh, renderCards } = props;
+  const { t } = useTranslation();
+  const now = useNow();
+  const summaries = useSummaries(entries, getQuota);
+  const [view, setView] = useState('ledger');
+  return (
+    <div className={styles.root}>
+      <div className={styles.viewRow}>
+        <Select
+          value={view}
+          size="sm"
+          ariaLabel="View"
+          onChange={setView}
+          options={[
+            { value: 'ledger', label: 'Ledger' },
+            { value: 'cards', label: 'Cards' },
+          ]}
+        />
+      </div>
+      <div className={styles.summaryRow}>
+        {summaries.map((s) => (
+          <SummaryCard key={s.type} summary={s} theme={resolvedTheme} now={now} />
+        ))}
+      </div>
+      {view === 'cards'
+        ? renderCards(entries)
+        : summaries.map((s) => (
+            <section key={s.type} className={styles.group}>
+              <h3 className={styles.groupTitle}>
+                {getTypeLabel(t, s.type)} <span className={styles.muted}>{s.rows.length}</span>
+              </h3>
+              {s.rows.map((row) => (
+                <div key={row.entry.file.name} className={styles.ledgerRow}>
+                  <div className={styles.nameCell}>
+                    <div className={styles.fileName}>{getQuotaDisplayName(row.entry.file)}</div>
+                    <PlanLine row={row} now={now} />
+                  </div>
+                  <div className={styles.windowCells}>
+                    {row.status === 'success' ? (
+                      <>
+                        {s.totals.map((c) => {
+                          const w = row.windows.find((x) => x.id === c.id);
+                          return w ? (
+                            <WindowCell
+                              key={c.id}
+                              label={w.label}
+                              left={w.left}
+                              resetAtMs={w.resetAtMs}
+                              now={now}
+                            />
+                          ) : (
+                            <div key={c.id} />
+                          );
+                        })}
+                        <ExtraCell row={row} now={now} />
+                      </>
+                    ) : (
+                      <RowState
+                        row={row}
+                        onRefresh={() => onRefresh(row.entry)}
+                        canRefresh={canRefresh}
+                      />
+                    )}
+                  </div>
+                  <Actions
+                    row={row}
+                    onRefresh={() => onRefresh(row.entry)}
+                    canRefresh={canRefresh}
+                  />
+                </div>
+              ))}
+            </section>
+          ))}
+    </div>
+  );
+}
+
+/* ---------- Variant B: provider panels, totals in the column heads ---------- */
+
+function VariantB(props: QuotaPrototypeProps) {
+  const { entries, getQuota, resolvedTheme, canRefresh, onRefresh } = props;
+  const { t } = useTranslation();
+  const now = useNow();
+  const summaries = useSummaries(entries, getQuota);
+  return (
+    <div className={styles.root}>
+      {summaries.map((s) => {
+        const cols = s.totals;
+        const hasExtra = s.rows.some((r) => r.manualResets || r.credits);
+        const grid = {
+          gridTemplateColumns: `minmax(220px, 1.4fr) repeat(${cols.length + (hasExtra ? 1 : 0)}, minmax(150px, 1fr)) auto`,
+        };
+        return (
+          <section key={s.type} className={styles.panel}>
+            <div className={styles.panelGrid} style={grid}>
+              <div className={styles.panelHeadCell}>
+                <div className={styles.summaryHead}>
+                  <ProviderIcon type={s.type} theme={resolvedTheme} />
+                  <strong>{getTypeLabel(t, s.type)}</strong>
+                </div>
+                <div className={styles.muted}>
+                  {s.rows.length} credential{s.rows.length === 1 ? '' : 's'} · total left
+                </div>
+              </div>
+              {cols.map((c) => (
+                <div
+                  key={c.id}
+                  className={`${styles.panelHeadCell} ${c === s.headline ? styles.headlineCol : ''}`}
+                >
+                  <div className={styles.windowHead}>
+                    <span className={styles.windowLabel}>{c.label}</span>
+                  </div>
+                  <div className={styles.midNumber}>
+                    {pct(c.sumLeft)} <span className={styles.muted}>of {c.outOf}%</span>
+                  </div>
+                  <Segments values={c.segments} />
+                  <When atMs={c.soonestResetMs} now={now} />
+                </div>
+              ))}
+              {hasExtra && <div className={styles.panelHeadCell} />}
+              <div className={styles.panelHeadCell} />
+
+              {s.rows.map((row) => (
+                <div key={row.entry.file.name} className={styles.panelRow}>
+                  <div className={styles.nameCell}>
+                    <div className={styles.fileName}>{getQuotaDisplayName(row.entry.file)}</div>
+                    <PlanLine row={row} now={now} />
+                  </div>
+                  {row.status === 'success' ? (
+                    <>
+                      {cols.map((c) => {
+                        const w = row.windows.find((x) => x.id === c.id);
+                        return w ? (
+                          <WindowCell key={c.id} left={w.left} resetAtMs={w.resetAtMs} now={now} />
+                        ) : (
+                          <div key={c.id} className={styles.muted}>
+                            —
+                          </div>
+                        );
+                      })}
+                      {hasExtra && (
+                        <div>
+                          <ExtraCell row={row} now={now} />
+                        </div>
+                      )}
+                    </>
+                  ) : (
+                    <div style={{ gridColumn: `span ${cols.length + (hasExtra ? 1 : 0)}` }}>
+                      <RowState
+                        row={row}
+                        onRefresh={() => onRefresh(row.entry)}
+                        canRefresh={canRefresh}
+                      />
+                    </div>
+                  )}
+                  <Actions
+                    row={row}
+                    onRefresh={() => onRefresh(row.entry)}
+                    canRefresh={canRefresh}
+                  />
+                </div>
+              ))}
+            </div>
+          </section>
+        );
+      })}
+    </div>
+  );
+}
+
+/* ---------- Variant C: one queue across providers, expiring-first ---------- */
+
+function VariantC(props: QuotaPrototypeProps) {
+  const { entries, getQuota, resolvedTheme, canRefresh, onRefresh } = props;
+  const { t } = useTranslation();
+  const now = useNow();
+  const summaries = useSummaries(entries, getQuota);
+  const ranked = useMemo(() => {
+    const rows = summaries.flatMap((s) => s.rows).map((row) => ({ row, u: urgencyOf(row, now) }));
+    const rank = (x: (typeof rows)[number]) =>
+      x.row.status !== 'success' ? 3 : !x.u.usable ? 2 : x.u.urgency === null ? 1 : 0;
+    return rows.sort((a, b) => rank(a) - rank(b) || (b.u.urgency ?? 0) - (a.u.urgency ?? 0));
+  }, [summaries, now]);
+
+  let position = 0;
+  return (
+    <div className={styles.root}>
+      <div className={styles.strip}>
+        {summaries.map((s) => (
+          <div key={s.type} className={styles.stripItem}>
+            <ProviderIcon type={s.type} theme={resolvedTheme} />
+            <span>{getTypeLabel(t, s.type)}</span>
+            {s.headline && (
+              <>
+                <strong>{pct(s.headline.sumLeft)}</strong>
+                <span className={styles.muted}>
+                  of {s.headline.outOf}% · {s.headline.label}
+                </span>
+                <div className={styles.stripBar}>
+                  <Segments values={s.headline.segments} />
+                </div>
+              </>
+            )}
+          </div>
+        ))}
+      </div>
+      <p className={styles.muted}>
+        Order: usable credentials first, by urgency = % left in the longest window ÷ hours until it
+        resets (the map's expiring-first rule). The panel computes this; it is not the router's
+        pick.
+      </p>
+      <div className={styles.queue}>
+        {ranked.map(({ row, u }) => {
+          const usable = row.status === 'success' && u.usable;
+          if (usable) position += 1;
+          return (
+            <div
+              key={row.entry.file.name}
+              className={`${styles.queueRow} ${usable ? '' : styles.dimmed}`}
+            >
+              <div className={styles.rank}>{usable ? position : '–'}</div>
+              <ProviderIcon type={row.entry.type} theme={resolvedTheme} />
+              <div className={styles.nameCell}>
+                <div className={styles.fileName}>{getQuotaDisplayName(row.entry.file)}</div>
+                <PlanLine row={row} now={now} />
+              </div>
+              {row.status === 'success' && u.window ? (
+                <>
+                  <div className={styles.queueMain}>
+                    <WindowCell
+                      label={u.window.label}
+                      left={u.window.left}
+                      resetAtMs={u.window.resetAtMs}
+                      now={now}
+                    />
+                  </div>
+                  <div className={styles.queueUrgency}>
+                    <div className={styles.muted}>urgency</div>
+                    <strong>{u.urgency === null ? '--' : u.urgency.toFixed(2)}</strong>
+                    <div className={styles.small}>%/h</div>
+                  </div>
+                  <div className={styles.chips}>
+                    {u.blockedBy && (
+                      <span className={`${styles.chip} ${styles.chipBad}`}>
+                        blocked: {u.blockedBy.label} empty
+                      </span>
+                    )}
+                    {row.windows
+                      .filter((w) => w !== u.window)
+                      .map((w) => (
+                        <span key={w.id} className={`${styles.chip}`}>
+                          <span className={`${styles.dot} ${levelClass(w.left)}`} />
+                          {w.label} {pct(w.left)}
+                        </span>
+                      ))}
+                    {row.manualResets && (
+                      <span className={styles.chip}>{row.manualResets.count} manual resets</span>
+                    )}
+                  </div>
+                </>
+              ) : (
+                <div className={styles.queueMain}>
+                  <RowState
+                    row={row}
+                    onRefresh={() => onRefresh(row.entry)}
+                    canRefresh={canRefresh}
+                  />
+                </div>
+              )}
+              <Actions row={row} onRefresh={() => onRefresh(row.entry)} canRefresh={canRefresh} />
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
+
+export function QuotaPrototype(props: QuotaPrototypeProps) {
+  if (props.variant === 'B') return <VariantB {...props} />;
+  if (props.variant === 'C') return <VariantC {...props} />;
+  return <VariantA {...props} />;
+}
diff --git a/src/features/quota/prototype/model.ts b/src/features/quota/prototype/model.ts
new file mode 100644
index 0000000..1696302
--- /dev/null
+++ b/src/features/quota/prototype/model.ts
@@ -0,0 +1,211 @@
+/**
+ * PROTOTYPE (throwaway): data model for the Quota Management layout prototype.
+ * Branch prototype/quota-ledger only. Answers bandoyer/CLIProxyAPI#30.
+ *
+ * Normalizes each credential's stock quota state into windows, then sums a
+ * provider's windows across its credentials for the summary cards.
+ */
+
+import type { TFunction } from 'i18next';
+import type { ClaudeQuotaState, CodexQuotaState, XaiQuotaState } from '@/types';
+import { normalizePlanType, parseIsoToMs, resolveResetMs } from '@/utils/quota';
+import type { QuotaFileEntry } from '../logic';
+import type { QuotaCardState } from '../providers';
+import type { QuotaProviderType } from '../providers/types';
+
+export interface ProtoWindow {
+  id: string;
+  label: string;
+  /** Percent left, 0..100; null when the reading has no value. */
+  left: number | null;
+  resetAtMs: number | null;
+  periodHours: number | null;
+}
+
+export interface ProtoRow {
+  entry: QuotaFileEntry;
+  quota: QuotaCardState | undefined;
+  status: QuotaCardState['status'];
+  windows: ProtoWindow[];
+  plan: string | null;
+  /** Codex subscription renewal instant. */
+  renewsAtMs: number | null;
+  manualResets: { count: number; firstExpiryMs: number | null } | null;
+  /** xAI monthly credits, in cents. */
+  credits: { usedCents: number | null; limitCents: number | null } | null;
+}
+
+export interface ProtoWindowTotal {
+  id: string;
+  label: string;
+  periodHours: number | null;
+  sumLeft: number | null;
+  /** 100 per credential that has this window. */
+  outOf: number;
+  /** One segment per credential, in row order. */
+  segments: (number | null)[];
+  soonestResetMs: number | null;
+}
+
+export interface ProtoProviderSummary {
+  type: QuotaProviderType;
+  rows: ProtoRow[];
+  totals: ProtoWindowTotal[];
+  headline: ProtoWindowTotal | null;
+}
+
+const leftFromUsed = (used: number | null | undefined): number | null =>
+  typeof used === 'number' && Number.isFinite(used) ? Math.max(0, 100 - used) : null;
+
+const codexPlanKey = (planType: string | null | undefined): string | null => {
+  const normalized = normalizePlanType(planType);
+  if (!normalized) return null;
+  if (normalized === 'pro') return 'codex_quota.plan_pro';
+  if (normalized === 'plus') return 'codex_quota.plan_plus';
+  if (normalized === 'team') return 'codex_quota.plan_team';
+  if (normalized === 'free') return 'codex_quota.plan_free';
+  return null;
+};
+
+export function buildRow(
+  entry: QuotaFileEntry,
+  quota: QuotaCardState | undefined,
+  t: TFunction
+): ProtoRow {
+  const row: ProtoRow = {
+    entry,
+    quota,
+    status: quota?.status ?? 'idle',
+    windows: [],
+    plan: null,
+    renewsAtMs: null,
+    manualResets: null,
+    credits: null,
+  };
+  if (!quota || quota.status !== 'success') return row;
+
+  if (entry.type === 'claude') {
+    const q = quota as unknown as ClaudeQuotaState;
+    row.windows = (q.windows ?? []).map((w) => ({
+      id: w.id,
+      label: w.labelKey ? t(w.labelKey) : w.label,
+      left: leftFromUsed(w.usedPercent),
+      resetAtMs: w.resetAtMs ?? null,
+      periodHours: w.periodHours ?? null,
+    }));
+    row.plan = q.planType ? t(`claude_quota.${q.planType}`) : null;
+  } else if (entry.type === 'codex') {
+    const q = quota as unknown as CodexQuotaState;
+    row.windows = (q.windows ?? []).map((w) => ({
+      id: w.id,
+      label: w.labelKey ? t(w.labelKey, w.labelParams as Record<string, string>) : w.label,
+      left: leftFromUsed(w.usedPercent),
+      resetAtMs: w.resetAtMs ?? null,
+      periodHours: w.periodHours ?? null,
+    }));
+    const key = codexPlanKey(q.planType);
+    row.plan = key ? t(key) : (q.planType ?? null);
+    row.renewsAtMs = resolveResetMs([q.subscriptionActiveUntil ?? null]);
+    const available = (q.rateLimitResetCredits ?? [])
+      .filter((c) => c.status === 'available')
+      .map((c) => parseIsoToMs(c.expiresAt))
+      .filter((ms): ms is number => ms !== null)
+      .sort((a, b) => a - b);
+    if (q.rateLimitResetCreditsAvailableCount != null) {
+      row.manualResets = {
+        count: q.rateLimitResetCreditsAvailableCount,
+        firstExpiryMs: available[0] ?? null,
+      };
+    }
+  } else if (entry.type === 'xai') {
+    const billing = (quota as unknown as XaiQuotaState).billing;
+    if (billing) {
+      row.windows = [
+        {
+          id: `xai:${billing.periodType}`,
+          label: billing.periodType === 'weekly' ? t('xai_quota.weekly_limit') : 'Monthly limit',
+          left: leftFromUsed(billing.usedPercent ?? billing.usagePercent),
+          resetAtMs: parseIsoToMs(billing.periodEnd ?? billing.billingPeriodEnd),
+          periodHours: billing.periodType === 'weekly' ? 168 : 720,
+        },
+      ];
+      row.plan = billing.planLabel ?? null;
+      row.credits = { usedCents: billing.usedCents, limitCents: billing.monthlyLimitCents };
+    }
+  }
+  return row;
+}
+
+export function summarize(type: QuotaProviderType, rows: ProtoRow[]): ProtoProviderSummary {
+  const order: string[] = [];
+  const byId = new Map<string, ProtoWindowTotal>();
+  rows.forEach((row) =>
+    row.windows.forEach((w) => {
+      if (!byId.has(w.id)) {
+        order.push(w.id);
+        byId.set(w.id, {
+          id: w.id,
+          label: w.label,
+          periodHours: w.periodHours,
+          sumLeft: null,
+          outOf: 0,
+          segments: [],
+          soonestResetMs: null,
+        });
+      }
+    })
+  );
+
+  const now = Date.now();
+  order.forEach((id) => {
+    const total = byId.get(id)!;
+    rows.forEach((row) => {
+      const w = row.windows.find((x) => x.id === id);
+      if (!w) return;
+      total.outOf += 100;
+      total.segments.push(w.left);
+      if (w?.left != null) total.sumLeft = (total.sumLeft ?? 0) + w.left;
+      if (w?.resetAtMs != null && w.resetAtMs > now) {
+        if (total.soonestResetMs === null || w.resetAtMs < total.soonestResetMs) {
+          total.soonestResetMs = w.resetAtMs;
+        }
+      }
+    });
+  });
+
+  // Shortest window first, as in Theo's rows; stable for equal lengths.
+  const totals = order
+    .map((id) => byId.get(id)!)
+    .sort((a, b) => (a.periodHours ?? Infinity) - (b.periodHours ?? Infinity));
+  // Headline: the longest window; among equally long ones, the one with the
+  // least left across the provider (the one that binds first). This reproduces
+  // Theo's "7-day Fable 5 409%" over "7-day limit 454%".
+  const longest = Math.max(0, ...totals.map((x) => x.periodHours ?? 0));
+  const headline =
+    totals
+      .filter((x) => (x.periodHours ?? 0) === longest)
+      .sort(
+        (a, b) =>
+          (a.sumLeft ?? Infinity) / (a.outOf || 1) - (b.sumLeft ?? Infinity) / (b.outOf || 1)
+      )[0] ?? null;
+
+  return { type, rows, totals, headline };
+}
+
+/**
+ * Expiring-first urgency from the map's routing rule: percent left in the
+ * longest window divided by hours to its reset. Usable only when no window is
+ * exhausted. The panel computes it for display; it is not the router's pick.
+ */
+export function urgencyOf(row: ProtoRow, now: number) {
+  if (row.windows.length === 0)
+    return { usable: false, urgency: null, window: null, blockedBy: null };
+  const blockedBy = row.windows.find((w) => w.left !== null && w.left <= 0) ?? null;
+  const longest = [...row.windows].sort(
+    (a, b) => (b.periodHours ?? 0) - (a.periodHours ?? 0) || (a.left ?? 101) - (b.left ?? 101)
+  )[0];
+  const hours =
+    longest.resetAtMs != null ? Math.max((longest.resetAtMs - now) / 3_600_000, 0.01) : null;
+  const urgency = longest.left != null && hours != null ? longest.left / hours : null;
+  return { usable: blockedBy === null, urgency, window: longest, blockedBy };
+}
