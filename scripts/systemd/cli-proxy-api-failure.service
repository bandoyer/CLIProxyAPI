# Sends a critical desktop notification when cli-proxy-api.service fails.
[Unit]
Description=Notify that CLIProxyAPI failed

[Service]
Type=oneshot
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=notify-send -u critical -a cli-proxy-api "CLIProxyAPI failed" "cli-proxy-api.service failed and will restart. See: journalctl --user -u cli-proxy-api.service"
